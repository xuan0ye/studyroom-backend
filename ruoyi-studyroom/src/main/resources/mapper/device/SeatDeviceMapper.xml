<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.studyroom.mapper.SeatDeviceMapper">

    <resultMap id="SeatDeviceVoResult" type="com.ruoyi.studyroom.domain.vo.SeatDeviceVo">
        <id property="deviceId" column="device_id"/>
        <result property="seatId" column="seat_id"/>
        <result property="deviceType" column="device_type"/>
        <result property="deviceName" column="device_name"/>
        <result property="protocol" column="protocol"/>
        <result property="deviceUid" column="device_uid"/>
        <result property="mqttTopic" column="mqtt_topic"/>
        <result property="status" column="status"/>
        <result property="autoControl" column="auto_control"/>
        <result property="roomId" column="room_id"/>
        <result property="seatNum" column="seat_num"/>
        <result property="areaName" column="area_name"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <select id="queryList" resultMap="SeatDeviceVoResult">
        SELECT d.*, s.seat_num, s.area_name
        FROM sr_seat_device d
        LEFT JOIN sr_seat s ON s.seat_id = d.seat_id
        <where>
            <if test="seatId != null">AND d.seat_id = #{seatId}</if>
            <if test="roomId != null">AND d.room_id = #{roomId}</if>
            <if test="deviceType != null and deviceType != ''">AND d.device_type = #{deviceType}</if>
        </where>
        ORDER BY d.create_time DESC
    </select>

</mapper>
